# ==========================================================================
# ConfortVets — copia este archivo a .env.local y completa los valores del
# proyecto de Supabase (Project Settings > API).
# ==========================================================================

# URL pública del proyecto y llave anónima: se usan en el navegador. No son
# secretas (lo que protege los datos es RLS, no esta llave).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx...

# Llave de servicio (service_role): SECRETA. Se salta RLS por completo.
# Solo se usa en el servidor. Nunca debe llegar al navegador ni a un
# repositorio. En Netlify va en Site configuration > Environment variables.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx...

# Solo para el respaldo (scripts/backup.mjs). Mínimo 16 caracteres. Guárdala
# en un lugar seguro: sin ella no se puede abrir ningún respaldo.
# BACKUP_PASSWORD=
